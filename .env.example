# Environment Mode
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# PostgreSQL Database
DATABASE_URL=postgresql://auth_user:auth_password@localhost:5432/auth_db
PGHOST=localhost
PGPORT=5432
PGUSER=auth_user
PGPASSWORD=auth_password
PGDATABASE=auth_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=super_secret_jwt_access_key_min_32_chars_long!!
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_chars_long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security & Rate Limiting
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECONDS=900
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=info
